# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<ep-project-id>.pooler.neon.tech/blinkit_footwear?sslmode=require

# Authentication & Security
SECRET_KEY=supersecretkey_blinkit_clone_123_footwear_production_secret
JWT_SECRET=supersecretkey_blinkit_clone_123_footwear_production_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Neon Object Storage (S3-Compatible)
AWS_ACCESS_KEY_ID=your_neon_s3_access_key
AWS_SECRET_ACCESS_KEY=your_neon_s3_secret_key
AWS_ENDPOINT_URL_S3=https://your-project.s3.neon.tech
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=premium-footwear

# Email Verification (SMTP for OTPs)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@aurakicks.com

# Server & CORS Configuration
PORT=5000
API_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","*"]
