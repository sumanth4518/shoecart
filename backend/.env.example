# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
SECRET_KEY=replace_with_your_strong_random_secret_key_here
JWT_SECRET=replace_with_your_strong_random_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Neon Object Storage (AWS S3-compatible)
AWS_ACCESS_KEY_ID=your_neon_storage_access_key
AWS_SECRET_ACCESS_KEY=your_neon_storage_secret_key
AWS_ENDPOINT_URL_S3=https://your-bucket-endpoint.storage.c-9.us-east-2.aws.neon.tech
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=shoecart

# Stripe Payment Gateway (Test Mode)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# Storefront URL (Used for Stripe redirect success/cancel callbacks)
FRONTEND_URL=https://aura-kicks-frontend.onrender.com

# Server & CORS Configuration
PORT=5000
ALLOWED_ORIGINS=["https://aura-kicks-frontend.onrender.com","https://aura-kicks-admin.onrender.com","http://localhost:3000","http://localhost:3001","*"]

# Email / OTP Verification (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@aurakicks.com
